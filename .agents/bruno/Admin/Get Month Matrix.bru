meta {
  name: Get Month Matrix
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/admin/matrix?messId={{messId}}&yearMonth=2026-03
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

params:query {
  messId: {{messId}}
  yearMonth: 2026-03
}

docs {
  # Get Month Matrix

  **Requires `SYSTEM_ADMIN` role.**

  Returns the full admin matrix: every member × every day of the given month.
  Shows breakfast / lunch / dinner / guest status, running totals and balances.

  - `yearMonth` — format `YYYY-MM` (optional, defaults to current month)

  ## Responses
  | Code | Meaning |
  |------|---------|
  | 200  | `MonthMatrixResponse` with nested member rows and daily logs |
  | 401  | Missing or invalid token |
  | 403  | Insufficient role (not SYSTEM_ADMIN) |
  | 404  | Mess not found |
}
