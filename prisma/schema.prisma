generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Mess {
  id                     String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name                   String
  inviteCode             String   @unique @map("invite_code")
  /// Legacy dinner cutoff — used as fallback when meal_configs are absent.
  /// Prefer querying meal_configs for per-meal cutoff enforcement.
  cutOffTime             DateTime @map("cut_off_time") @db.Time(6)
  estimatedMonthlyBudget Decimal? @map("estimated_monthly_budget") @db.Decimal(10, 2)
  /// Day of the month when the billing period starts (1–28). Default 1 = calendar month.
  monthStartDay          Int      @default(1) @map("month_start_day")
  /// Who pays for guest meals: HOST = the member who brought the guest, SHARED = spread across the mess via the meal rate
  guestMealPolicy        String   @default("HOST") @map("guest_meal_policy")
  /// When true, bazaar expenses are credited to the member who recorded them (they paid from their own pocket)
  bazaarCountsAsDeposit  Boolean  @default(false) @map("bazaar_counts_as_deposit")
  /// When true, closing a month carries each member's balance into the next month
  carryForwardBalance    Boolean  @default(true) @map("carry_forward_balance")
  /// Weekend days for meal preferences, comma-separated JS weekday numbers (0=Sun … 6=Sat)
  weekendDays            String   @default("0,6") @map("weekend_days")
  /// Meals a member eats by default when they have not set their own (JSON: WEEKDAY/WEEKEND -> BREAKFAST/LUNCH/DINNER -> bool)
  defaultMeals           String?  @map("default_meals")
  isActive               Boolean  @default(true) @map("is_active")
  /// New joiners need an admin's approval before they can use the mess
  requireJoinApproval    Boolean  @default(true) @map("require_join_approval")
  /// Member who created the mess
  ownerId                String?  @map("owner_id") @db.Uuid
  /// Subscription plan key (see src/lib/plans.ts). Everyone is FREE for now.
  plan                   String   @default("FREE")
  planExpiresAt          DateTime? @map("plan_expires_at") @db.Timestamptz(6)
  /// Set by the platform team; members of a suspended mess cannot sign in
  suspendedAt            DateTime? @map("suspended_at") @db.Timestamptz(6)
  suspendedReason        String?   @map("suspended_reason")
  /// Soft delete — the admin deleted the mess; the platform team can restore it
  deletedAt              DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  members         Member[]
  messMonths      MessMonth[]
  dailyLogs       DailyLog[]
  expenses        Expense[]
  bazaarSessions  BazaarSession[]
  ledgerEntries   LedgerEntry[]
  auditLogs       AuditLog[]
  memberships     MessMembership[]
  telegramGroups  TelegramGroup[]
  mealPreferences UserMealPreference[]
  mealConfigs     MealConfig[]
  cookNotes       DailyCookNote[]
  memberClaims    MemberClaim[]

  @@map("messes")
}

model Member {
  id             String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  messId         String?   @map("mess_id") @db.Uuid
  name           String
  /// NULL for a name-only member (added by the admin, has not joined yet)
  email          String?   @unique
  phone          String?
  /// NULL for a name-only member: counted everywhere, cannot sign in
  passwordHash   String?   @map("password_hash")
  /// SYSTEM_ADMIN | ADMIN | MANAGER | MEMBER | GUEST
  role           String    @default("MEMBER")
  telegramUid    BigInt?   @unique @map("telegram_uid")
  telegramLinked Boolean   @default(false) @map("telegram_linked")
  isActive       Boolean   @default(true) @map("is_active")
  isGuest        Boolean   @default(false) @map("is_guest")
  guestFrom      DateTime? @map("guest_from") @db.Date
  guestUntil     DateTime? @map("guest_until") @db.Date
  invitedBy      String?   @map("invited_by") @db.Uuid
  joinedAt       DateTime  @default(now()) @map("joined_at") @db.Timestamptz(6)
  /// APPROVED | PENDING (waiting for the mess admin) | REJECTED
  joinStatus     String    @default("APPROVED") @map("join_status")
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(6)
  /// Tokens issued before this moment are rejected (password change / reset)
  passwordChangedAt DateTime? @map("password_changed_at") @db.Timestamptz(6)
  lastLoginAt    DateTime? @map("last_login_at") @db.Timestamptz(6)
  /// Account deleted by the user — personal data is anonymised, records kept for the mess's accounts
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)

  mess              Mess?           @relation(fields: [messId], references: [id], onDelete: Cascade)
  inviter           Member?         @relation("InvitedBy", fields: [invitedBy], references: [id])
  invitees          Member[]        @relation("InvitedBy")
  dailyLogs         DailyLog[]
  addedExpenses     Expense[]       @relation("AddedBy")
  bazaarSessions    BazaarSession[] @relation("SessionCreator")
  ledgerEntries     LedgerEntry[]   @relation("MemberLedger")
  createdLedgers    LedgerEntry[]   @relation("CreatedBy")
  auditLogs         AuditLog[]
  memberships       MessMembership[]
  mealPreferences   UserMealPreference[]
  managedPeriods    MessMonth[]        @relation("PeriodManager")
  claims            MemberClaim[]

  @@index([messId], map: "idx_members_mess")
  @@index([telegramUid], map: "idx_members_telegram")
  @@map("members")
}

model MessMonth {
  id           String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  messId       String    @map("mess_id") @db.Uuid
  yearMonth    String    @map("year_month")
  /// Explicit period boundaries — replaces calendar-month derivation
  startDate    DateTime  @map("start_date") @db.Date
  endDate      DateTime  @map("end_date") @db.Date
  /// The designated manager(s) for this period (nullable — inherits current managers)
  managerId    String?   @map("manager_id") @db.Uuid
  isClosed     Boolean   @default(false) @map("is_closed")
  closedAt     DateTime? @map("closed_at") @db.Timestamptz(6)
  mealRate     Decimal?  @map("meal_rate") @db.Decimal(10, 4)
  totalExpense Decimal   @default(0) @map("total_expense") @db.Decimal(10, 2)
  /// Every figure of the period, frozen the moment it is closed (see PeriodSnapshot in financial.ts).
  /// Closed periods are always read from here, so changing a setting later cannot rewrite history.
  snapshot     Json?
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  mess          Mess          @relation(fields: [messId], references: [id], onDelete: Cascade)
  manager       Member?       @relation("PeriodManager", fields: [managerId], references: [id])
  ledgerEntries LedgerEntry[]

  @@unique([messId, yearMonth])
  @@index([messId, isClosed], map: "idx_mess_months_open")
  @@map("mess_months")
}

/// Integer-count based daily meal log.
/// breakfastCount/lunchCount/dinnerCount represent the number of portions
/// (0 = not eating, 1 = normal, 2+ = extra / family).
/// override_type: null = auto-generated | USER = member command | ADMIN = admin command | SYSTEM = cron
model DailyLog {
  id             String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  messId         String   @map("mess_id") @db.Uuid
  memberId       String   @map("member_id") @db.Uuid
  logDate        DateTime @map("log_date") @db.Date
  breakfastCount Int      @default(1) @map("breakfast_count")
  lunchCount     Int      @default(1) @map("lunch_count")
  dinnerCount    Int      @default(1) @map("dinner_count")
  /// LEGACY: guests who eat every meal the host eats. New changes use the per-meal columns
  /// below and set this to 0 (see src/lib/guests.ts). Kept so older days bill the same.
  guestCount     Int      @default(0) @map("guest_count")
  /// Guests for each meal, independent of each other (lunch only, dinner only, both)
  guestBreakfast Int      @default(0) @map("guest_breakfast")
  guestLunch     Int      @default(0) @map("guest_lunch")
  guestDinner    Int      @default(0) @map("guest_dinner")
  frozen         Boolean  @default(false)
  isOverride     Boolean  @default(false) @map("is_override")
  /// null | USER | ADMIN | SYSTEM
  overrideType   String?  @map("override_type")
  toggledAt      DateTime @default(now()) @map("toggled_at") @db.Timestamptz(6)

  mess   Mess   @relation(fields: [messId], references: [id], onDelete: Cascade)
  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([messId, memberId, logDate])
  @@index([messId, logDate], map: "idx_daily_logs_mess_date")
  @@index([memberId, logDate], map: "idx_daily_logs_member_date")
  @@map("daily_logs")
}

/// Per-meal, per-mess configuration: enabled flag and cutoff time.
/// This drives the dynamic time-based meal targeting:
///   sort by cutoff_time ASC → find first meal where now < cutoff_time.
/// Seed three rows (BREAKFAST/LUNCH/DINNER) on mess creation.
model MealConfig {
  id         String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  messId     String   @map("mess_id") @db.Uuid
  /// BREAKFAST | LUNCH | DINNER
  mealType   String   @map("meal_type")
  enabled    Boolean  @default(true)
  cutoffTime DateTime @map("cutoff_time") @db.Time(6)
  /// Maximum allowed count per member per meal (for validation)
  maxCount   Int      @default(10) @map("max_count")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  mess Mess @relation(fields: [messId], references: [id], onDelete: Cascade)

  @@unique([messId, mealType])
  @@index([messId], map: "idx_meal_configs_mess")
  @@map("meal_configs")
}

model Expense {
  id          String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  messId      String   @map("mess_id") @db.Uuid
  addedBy     String?  @map("added_by") @db.Uuid
  /// Optional link to a BazaarSession — null for legacy/standalone expenses
  sessionId   String?  @map("session_id") @db.Uuid
  amount      Decimal  @db.Decimal(10, 2)
  category    String
  description String?
  expenseDate DateTime @map("expense_date") @db.Date
  yearMonth   String   @map("year_month")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  mess          Mess           @relation(fields: [messId], references: [id], onDelete: Cascade)
  addedByMember Member?        @relation("AddedBy", fields: [addedBy], references: [id])
  session       BazaarSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([messId, yearMonth], map: "idx_expenses_mess_month")
  @@index([sessionId], map: "idx_expenses_session")
  @@map("expenses")
}

/// A shopping trip — groups multiple Expense items under one session.
/// shoppers: JSON array of { id: string, name: string } who physically went to market.
model BazaarSession {
  id          String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  messId      String    @map("mess_id") @db.Uuid
  sessionDate DateTime  @map("session_date") @db.Date
  yearMonth   String    @map("year_month")
  /// JSON: [{ id: string, name: string }]
  shoppers    Json      @default("[]")
  note        String?
  createdBy   String?   @map("created_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  /// Soft delete — voided sessions stay in DB for audit trail
  isVoided    Boolean   @default(false) @map("is_voided")
  voidReason  String?   @map("void_reason")
  voidedAt    DateTime? @map("voided_at") @db.Timestamptz(6)
  voidedBy    String?   @map("voided_by") @db.Uuid
  /// ITEMIZED = line items typed in; MEMO_TOTAL = photo of the paper memo plus one total
  entryMode   String    @default("ITEMIZED") @map("entry_mode")

  mess     Mess          @relation(fields: [messId], references: [id], onDelete: Cascade)
  creator  Member?       @relation("SessionCreator", fields: [createdBy], references: [id])
  expenses Expense[]
  memos    BazaarMemo[]

  @@index([messId, yearMonth], map: "idx_bazaar_sessions_mess_month")
  @@map("bazaar_sessions")
}

/// Photo of the paper memo (receipt) for a bazaar session. Kept as evidence, never edited or deleted.
/// Phase 2: an OCR job reads these and suggests the line items.
model BazaarMemo {
  id         String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  sessionId  String   @map("session_id") @db.Uuid
  messId     String   @map("mess_id") @db.Uuid
  mimeType   String   @map("mime_type")
  sizeBytes  Int      @map("size_bytes")
  data       Bytes
  uploadedBy String?  @map("uploaded_by") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  session BazaarSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId], map: "idx_bazaar_memos_session")
  @@map("bazaar_memos")
}

model LedgerEntry {
  id          String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  messId      String    @map("mess_id") @db.Uuid
  messMonthId String?   @map("mess_month_id") @db.Uuid
  memberId    String    @map("member_id") @db.Uuid
  entryType   String    @map("entry_type")
  amount      Decimal   @db.Decimal(10, 2)
  note        String?
  createdBy   String?   @map("created_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  /// Soft delete — voided contributions stay in DB for audit trail
  isVoided    Boolean   @default(false) @map("is_voided")
  voidReason  String?   @map("void_reason")
  voidedAt    DateTime? @map("voided_at") @db.Timestamptz(6)
  voidedBy    String?   @map("voided_by") @db.Uuid

  mess      Mess       @relation(fields: [messId], references: [id], onDelete: Cascade)
  messMonth MessMonth? @relation(fields: [messMonthId], references: [id])
  member    Member     @relation("MemberLedger", fields: [memberId], references: [id], onDelete: Cascade)
  creator   Member?    @relation("CreatedBy", fields: [createdBy], references: [id])

  @@index([memberId, messMonthId], map: "idx_ledger_member_month")
  @@map("ledger_entries")
}

model AuditLog {
  id          String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  messId      String?  @map("mess_id") @db.Uuid
  actorId     String?  @map("actor_id") @db.Uuid
  action      String
  targetTable String?  @map("target_table")
  targetId    String?  @map("target_id") @db.Uuid
  oldValue    Json?    @map("old_value")
  newValue    Json?    @map("new_value")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  mess  Mess?   @relation(fields: [messId], references: [id])
  actor Member? @relation(fields: [actorId], references: [id])

  @@map("audit_log")
}

model TelegramGroup {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  chatId    String   @unique @map("chat_id")
  chatName  String?  @map("chat_name")
  messId    String   @map("mess_id") @db.Uuid
  timezone  String   @default("Asia/Dhaka")
  isActive  Boolean  @default(true) @map("is_active")
  /// The bot's latest "Open my Mealio" reply, deleted when the next /mealio comes in (keeps the chat tidy)
  lastPromptMessageId Int? @map("last_prompt_message_id")
  /// The pinned "Open my Mealio" message, so it is pinned only once
  pinnedMessageId     Int? @map("pinned_message_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  mess Mess @relation(fields: [messId], references: [id], onDelete: Cascade)

  @@map("telegram_groups")
}

/// One-time Telegram link codes. Issued by the web app to a logged-in member
/// (memberId set); redeemed in the bot with `/link <code>`.
model TelegramOtp {
  id         String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  memberId   String?  @map("member_id") @db.Uuid
  telegramId String?  @map("telegram_id")
  phone      String?
  otp        String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(6)
  used       Boolean  @default(false)
  /// MEMBER = /link (links a person to their account), GROUP = /linkgroup (links a Telegram group to a mess)
  purpose    String   @default("MEMBER")
  /// For GROUP codes: the mess the code was issued for
  messId     String?  @map("mess_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([telegramId], map: "idx_telegram_otps_uid")
  @@index([otp], map: "idx_telegram_otps_code")
  @@map("telegram_otps")
}

model ProcessedUpdate {
  updateId    BigInt   @id @map("update_id")
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz(6)

  @@map("processed_updates")
}

model MessMembership {
  id       String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  memberId String   @map("member_id") @db.Uuid
  messId   String   @map("mess_id") @db.Uuid
  role     String
  isActive Boolean  @default(true) @map("is_active")
  joinedAt DateTime @default(now()) @map("joined_at") @db.Timestamptz(6)

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  mess   Mess   @relation(fields: [messId], references: [id], onDelete: Cascade)

  @@unique([memberId, messId])
  @@map("mess_memberships")
}

/// Cook's optional note for what was cooked per meal slot per day.
/// Useful for headcount detail view. One row per mess × date × slot.
model DailyCookNote {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  messId    String   @map("mess_id") @db.Uuid
  logDate   DateTime @map("log_date") @db.Date
  /// BREAKFAST | LUNCH | DINNER
  slot      String
  note      String?
  updatedBy String?  @map("updated_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  mess Mess @relation(fields: [messId], references: [id], onDelete: Cascade)

  @@unique([messId, logDate, slot])
  @@map("daily_cook_notes")
}

/// Per-user, per-mess default meal preferences.
/// defaultCount: how many portions to restore when re-enabling a meal (usually 1).
/// Missing row → enabled=true, defaultCount=1.
model UserMealPreference {
  id           String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  memberId     String   @map("member_id") @db.Uuid
  messId       String   @map("mess_id") @db.Uuid
  /// BREAKFAST | LUNCH | DINNER
  mealType     String   @map("meal_type")
  /// WEEKDAY | WEEKEND
  dayType      String   @map("day_type")
  enabled      Boolean  @default(true)
  defaultCount Int      @default(1) @map("default_count")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  mess   Mess   @relation(fields: [messId], references: [id], onDelete: Cascade)

  @@unique([memberId, messId, mealType, dayType])
  @@index([memberId, messId], map: "idx_meal_prefs_member_mess")
  @@map("user_meal_preferences")
}

/// One-time codes/tokens for password reset and email verification.
/// Only a SHA-256 hash is stored.
model AuthToken {
  id        String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  memberId  String    @map("member_id") @db.Uuid
  /// RESET | VERIFY_EMAIL | INVITE (invite to claim a name-only member)
  purpose   String
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  /// who issued it: SELF | MESS_ADMIN:<memberId> | PLATFORM:<adminId>
  issuedBy  String    @default("SELF") @map("issued_by")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([memberId, purpose], map: "idx_auth_tokens_member")
  @@map("auth_tokens")
}

/// Platform operators (super admins). Separate from mess members on purpose.
model PlatformAdmin {
  id           String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  email        String    @unique
  name         String
  passwordHash String    @map("password_hash")
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz(6)
  passwordChangedAt DateTime? @map("password_changed_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("platform_admins")
}

/// Everything platform admins do is recorded here.
model PlatformAuditLog {
  id         String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  adminId    String?  @map("admin_id") @db.Uuid
  action     String
  targetType String?  @map("target_type")
  targetId   String?  @map("target_id")
  detail     Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([createdAt], map: "idx_platform_audit_created")
  @@map("platform_audit_log")
}

/// Security-relevant events across all messes (monitoring).
model SecurityEvent {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  /// e.g. LOGIN_FAILED, LOGIN_OK, REGISTER, MESS_CREATED, JOIN_REQUESTED, RATE_LIMITED, PASSWORD_RESET
  type      String
  /// INFO | WARN | HIGH
  severity  String   @default("INFO")
  memberId  String?  @map("member_id") @db.Uuid
  messId    String?  @map("mess_id") @db.Uuid
  email     String?
  ip        String?
  detail    Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([createdAt], map: "idx_security_events_created")
  @@index([type, createdAt], map: "idx_security_events_type")
  @@index([ip, createdAt], map: "idx_security_events_ip")
  @@map("security_events")
}

/// Contact-support tickets from users (signed in or not).
model SupportTicket {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  memberId  String?  @map("member_id") @db.Uuid
  messId    String?  @map("mess_id") @db.Uuid
  name      String
  email     String
  /// ACCOUNT | BILLING | BUG | ABUSE | OTHER
  category  String   @default("OTHER")
  subject   String
  /// OPEN | WAITING_ON_USER | RESOLVED | CLOSED
  status    String   @default("OPEN")
  /// LOW | NORMAL | HIGH
  priority  String   @default("NORMAL")
  /// Lets a signed-out user read replies via a private link
  accessKeyHash String? @map("access_key_hash")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  messages SupportMessage[]

  @@index([status, updatedAt], map: "idx_support_tickets_status")
  @@index([memberId], map: "idx_support_tickets_member")
  @@map("support_tickets")
}

model SupportMessage {
  id         String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  ticketId   String   @map("ticket_id") @db.Uuid
  /// USER | STAFF
  authorType String   @map("author_type")
  authorId   String?  @map("author_id") @db.Uuid
  authorName String   @map("author_name")
  body       String
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt], map: "idx_support_messages_ticket")
  @@map("support_messages")
}

/// Someone who joined with the mess invite code and says "I am <name>" (a name-only member).
/// Their credentials wait here until the admin approves; then they move onto the member.
model MemberClaim {
  id           String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  messId       String    @map("mess_id") @db.Uuid
  memberId     String    @map("member_id") @db.Uuid
  name         String
  email        String
  passwordHash String    @map("password_hash")
  phone        String?
  /// PENDING | APPROVED | REJECTED
  status       String    @default("PENDING")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  decidedAt    DateTime? @map("decided_at") @db.Timestamptz(6)

  mess   Mess   @relation(fields: [messId], references: [id], onDelete: Cascade)
  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([messId, status], map: "idx_member_claims_mess")
  @@map("member_claims")
}
