# ──────────────────────────────────────────────────────────────────────────────
# MEALIO PRODUCTION ENVIRONMENT
#
# Copy these into your host's environment settings (Vercel: Project, Settings,
# Environment Variables). Never commit real values. A ready-to-fill copy with fresh
# secrets is generated by `npm run env:production` into .env.deploy.local.
# Lines marked REQUIRED stop the app from working if they are missing.
# ──────────────────────────────────────────────────────────────────────────────

# ── Database (Supabase) ── REQUIRED ───────────────────────────────────────────
# Supabase Dashboard, Settings, Database, Connection string.
# Runtime uses the transaction pooler (port 6543). Migrations use the session pooler (5432).
# Before the first deploy, run MIGRATION.sql once in the Supabase SQL Editor.
DATABASE_URL=
DIRECT_URL=

# ── Secrets ── REQUIRED (generated for you by `npm run env:production`) ───────
# Use values different from development. Changing JWT_SECRET signs everyone out.
JWT_SECRET=
# Separate key for the staff console. Leave empty to reuse JWT_SECRET (not recommended).
PLATFORM_JWT_SECRET=

# ── Public address ── REQUIRED ────────────────────────────────────────────────
# The https address people open. Used in emails and for the Telegram webhook.
NEXT_PUBLIC_APP_URL=https://your-domain.example
NEXT_PUBLIC_DEFAULT_LOCALE=en
NEXT_PUBLIC_USE_MOCK_DATA=false

# ── Redis (Upstash) ── strongly recommended ───────────────────────────────────
# Shared settings cache and rate limits. Without it, limits are per server instance only,
# which is much weaker on serverless hosting. console.upstash.com, your database, REST API.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Telegram bot ──────────────────────────────────────────────────────────────
# Token from @BotFather. Use a DIFFERENT bot for local testing than for production:
# a bot has one webhook, so sharing one makes localhost and production fight over it.
TELEGRAM_BOT_TOKEN=
# Generated for you. The webhook refuses every update without it.
TELEGRAM_WEBHOOK_SECRET=
# The bot's username without @ (shown on the link screen)
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
# After deploying: sign in to /en/console, open Telegram, press "Connect the bot".

# ── Email (Resend) ── optional ────────────────────────────────────────────────
# Turns on password reset links and email verification. Without it people reset with a
# one-time code from their mess admin or from the staff console.
# EMAIL_FROM must be on a domain you verified in Resend.
RESEND_API_KEY=
EMAIL_FROM="Mealtill <no-reply@your-domain.example>"

# ── Email by SMTP ── optional, used when Resend is not set ─────────────────────
# For example a Gmail account with an app password (Google Account, Security, App passwords).
# Mail from a personal Gmail can land in spam; the app tells people to check their spam folder.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
